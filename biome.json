{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"files": { "includes": ["**", "!**/node_modules"] },
	"formatter": { "enabled": true, "lineWidth": 120, "indentStyle": "tab" },
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": { "noExplicitAny": "off" },
			"style": { "noNonNullAssertion": "off" }
		}
	}
}
